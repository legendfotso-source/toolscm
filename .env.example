# ---------------------------------------------------------------------------
# Tools.cm — environment variables
#
# Copy this file to .env.local and fill in what you need. Everything here is
# OPTIONAL for phases 1 and 2: the site and all published tools work with no
# environment configuration at all, because processing happens in the browser.
#
# Anything named NEXT_PUBLIC_* is embedded in the JavaScript sent to the
# browser and is therefore PUBLIC. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Site -----------------------------------------------------------------
# Canonical origin, used for metadata, sitemap.xml and robots.txt.
# On Vercel this is inferred from the deployment when left empty.
NEXT_PUBLIC_SITE_URL=https://tools.cm

# Address shown on the contact page and in the legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=contact@tools.cm


# --- Background removal ---------------------------------------------------
# Where the segmentation model and its wasm runtime are fetched from.
# Left empty, the library's own CDN (staticimgly.com) is used — which is
# disclosed on the tool page and in the privacy policy. Set this to a path on
# your own origin if you choose to host the model files yourself.
# NEXT_PUBLIC_IMGLY_PUBLIC_PATH=/models/imgly/


# --- Advertising ----------------------------------------------------------
# Google AdSense publisher id (ca-pub-...). While this is empty, NO ad markup
# is rendered anywhere — not even an empty placeholder.
# Only set it once the site meets AdSense's policies and is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=


# ===========================================================================
# Accounts, usage limits and the admin dashboard (built and tested).
#
# Leave these empty and the site behaves exactly as it does with no database:
# every tool free, no limits, no accounts, no paywall. Adding them switches the
# business layer ON — but even then, the daily limit stays OFF until you set
# limits_enabled to true in /admin. Nothing starts turning people away by
# accident.
# ===========================================================================

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (formerly "anon") key. This one is PUBLIC by design — it
# ships in the browser bundle, and row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — the secret (formerly "service_role") key. It bypasses row level
# security completely. Never prefix it with NEXT_PUBLIC_, never commit it, and
# rotate it in the Supabase dashboard if it is ever pasted somewhere it should
# not have been.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the network fingerprint used as an anti-abuse ceiling. Any long
# random string. Raw IP addresses are never stored — only a salted hash — and
# rotating this salt invalidates every stored hash.
USAGE_HASH_SALT=

# --- Mobile Money, taken by hand ------------------------------------------
# How money actually changes hands before any payment provider is integrated:
# the customer sends the amount to one of these numbers and forwards the
# confirmation, and you activate Pro from /admin against the transaction id.
#
# Both operators are listed on the site on purpose. A customer on Orange
# sending to an MTN number pays a transfer fee on top of the subscription, and
# enough of them give up instead of paying it.
#
# These have real defaults in src/lib/site.ts, so the site works without
# setting them. Override them here for a staging deployment that should not
# point at a live account.
# NEXT_PUBLIC_MTN_NUMBER=+237 652 11 64 11
# NEXT_PUBLIC_MTN_NAME=Gakam Sylvie
# NEXT_PUBLIC_ORANGE_NUMBER=+237 699 74 49 70
# NEXT_PUBLIC_ORANGE_NAME=Epse Simo Gakam Sylvie

# Where customers send proof of payment, and where receipts are sent from.
# Digits only, international format, used to build wa.me links.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=237652116411

# ===========================================================================
# Payment providers (written, not yet exercised against a live account)
#
# Both are inert without keys, AND gated a second time by payments_enabled in
# /admin. Setting keys alone changes nothing: someone has to decide to switch
# payments on. Until then the Mobile Money instructions above are what the
# customer sees.
# ===========================================================================

# --- NotchPay (Mobile Money and cards, Cameroon) --------------------------
# The PUBLIC key goes in the Authorization header on every request, so it is
# NEXT_PUBLIC_ by nature. The webhook hash is a real secret: it is the only
# thing standing between a stranger with curl and a free subscription.
# NEXT_PUBLIC_NOTCHPAY_PUBLIC_KEY=
# NOTCHPAY_WEBHOOK_HASH=
# Override only for testing against a sandbox.
# NOTCHPAY_BASE_URL=https://api.notchpay.co

# --- Stripe (cards, international) ----------------------------------------
# Use test keys (sk_test_...) until a test payment has been verified end to
# end. STRIPE_WEBHOOK_SECRET is the whsec_... value from the endpoint you
# create in the Stripe dashboard — not the API key.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- The first administrator ----------------------------------------------
# The account with this email address is made an admin automatically the first
# time it signs in, so there is no chicken-and-egg problem on a fresh
# deployment. Clear it once you have admin access.
# ADMIN_EMAIL=
